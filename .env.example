# LCCI — environment contract
#
# Copy to `.env.local` for development, and set the same values in cPanel's
# Node.js application manager for production. `.env.local` is not committed and
# must not be; neither is anything in this file's shape with real values in it.
#
# Every value marked REQUIRED is validated at load by `src/server/env.ts`. A
# missing or unusable one is a 503 on the first request that needs it, never a
# default — a silent default here means CNICs written somewhere nobody chose.
#
# Generate the two secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"


# --- Site ---------------------------------------------------------------------

# REQUIRED. The canonical public origin, scheme included, no trailing slash.
#
# Load-bearing three times over: it is the `Origin` every state-changing server
# action is compared against, it is `allowedOrigins` for server actions in
# next.config.ts, and it is the domain sign-in mail has to come from. Getting it
# wrong does not break the site visibly — it breaks every form submission with a
# message about an unverified request.
SITE_ORIGIN=http://localhost:9000

# RECOMMENDED. The same origin again, for the browser.
#
# A second variable rather than a reuse of SITE_ORIGIN because this one is
# inlined into the client bundle at build time: `metadataBase` in
# src/app/layout.tsx resolves every canonical and Open Graph URL against it, and
# metadata is rendered where the client can see it. SITE_ORIGIN must stay
# server-side.
#
# Unset falls back to https://lcci.com.pk, so a staging build that forgets it
# publishes canonical URLs pointing at production. Set both, or neither.
NEXT_PUBLIC_SITE_URL=http://localhost:9000

# `development` locally, `production` on the host. Set by Next for `next dev`
# and `next build`; set it explicitly in cPanel, because Passenger does not.
NODE_ENV=development


# --- Database -----------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306

# A unix socket, which wins over DB_HOST and DB_PORT when set.
#
# THE ONE SHARED cPANEL USUALLY NEEDS. MySQL there is often configured to
# listen on a socket only, with TCP on 127.0.0.1 refused. mysql2 does not do
# what PHP and the C client do: they read the literal host `localhost` as "use
# the socket", mysql2 resolves it to 127.0.0.1 and dials TCP anyway. So the
# panel says "Host: localhost", you copy it in good faith, and you get
# `ECONNREFUSED 127.0.0.1:3306` with nothing visibly wrong.
#
# Find it with `mysqladmin variables | grep '  socket'` or `grep -r '^socket'
# /etc/my.cnf`. Usually /var/lib/mysql/mysql.sock. Leave empty for TCP, which
# is right on a development machine and on a VPS.
#
# `npm run db:check` tells you which of these is wrong in about a second.
DB_SOCKET=

# REQUIRED. cPanel prefixes both with the account name, e.g. `lcci_app`.
#
# Grant this user INSERT but NOT UPDATE or DELETE on `audit_log`. Per-table
# grants are available in cPanel, and that single grant is the cheapest
# tamper-resistance this host offers: the application can append to the audit
# log and cannot rewrite it.
DB_USER=
DB_PASSWORD=
DB_NAME=

# Per-PROCESS pool size, not per-application.
#
# Passenger spawns several workers and each gets its own pool, so the real
# connection count is this times the worker count. Shared cPanel MySQL commonly
# caps `max_user_connections` at 10-30, and exceeding it surfaces as
# intermittent ER_CON_COUNT_ERROR under exactly the load you most want to work.
# Measure the host's cap before raising this.
DB_POOL_SIZE=3


# --- Documents ----------------------------------------------------------------

# REQUIRED. Absolute path to the private document store.
#
# Must be OUTSIDE the application root and nowhere near `public/`. Two separate
# reasons, both of which have ruined someone's week before:
#
#   `public/` is served with no authentication, no access log and no
#   Content-Disposition, and `nosniff` does not help because a CNIC scan *is* a
#   genuine image.
#
#   The release procedure does `rm -rf .next` and copies over the app root, so a
#   store inside it is one future `--delete` away from being gone — along with
#   every applicant's identity documents.
#
# Create the directory by hand, once, mode 0700. The deploy must never create
# it: a deploy that silently creates a missing store is a deploy that silently
# points the application at an empty one.
PRIVATE_UPLOAD_ROOT=/home/USER/lcci-documents


# --- Secrets ------------------------------------------------------------------

# REQUIRED. 32 bytes, base64. Envelope-encrypts document bytes and the few
# encrypted columns (CNIC, passport, NTN, bank account, TOTP secret).
#
# Protects against filesystem exposure — a backup tarball leaving the server,
# cPanel's own backup store, a stray path readable by another tenant — and NOT
# against application compromise, because the application can obviously decrypt
# what it encrypts. On shared hosting with no disk encryption available at all,
# that is still most of the realistic threat model.
#
# Rotating this requires re-wrapping every document's data key. Do not rotate
# casually, and do not lose it: there is no recovery path.
ENCRYPTION_KEY=

# REQUIRED. 32 bytes, base64. Peppers IP and user-agent hashes before they
# become rate-limit keys or audit context, so neither table is an IP log and
# neither can be brute-forced back to addresses (the IPv4 space is small enough
# to enumerate in minutes without this).
IP_HASH_PEPPER=

# REQUIRED. The bearer token cPanel's cron presents to /api/cron/[job].
#
# Write it to a file readable only by the account and have the crontab read it
# with $(cat ...) — `npm run cron:print` generates exactly that. Never inline it
# in the crontab (world-readable in some configurations, and it lands in the
# mail cron sends about its own output) and never in a query string (Apache
# access logs, and the Referer of anything the response links to).
CRON_SECRET=


# --- Mail ---------------------------------------------------------------------

# The transport is chosen in this order: SMTP when SMTP_HOST is set, Postmark
# when POSTMARK_TOKEN is set instead, and otherwise the console — which logs the
# subject and recipient and sends nothing, and is the normal state of a
# development machine. MAIL_FROM is required by all of them.

# SMTP. The transport the chamber has today: a mailbox on its own mail server.
#
# Port 587 with STARTTLS is the default and the right answer almost everywhere;
# 465 is implicit TLS and is detected from the port number alone. The upgrade to
# TLS is required rather than opportunistic, so a server that omits STARTTLS from
# its greeting fails instead of sending sign-in codes in the clear.
#
# Two things that bite on shared cPanel. Some plans block outbound connections to
# third-party SMTP ports entirely, and the symptom is a connection timeout with
# nothing wrong in the configuration — the answer there is the host's own
# localhost:25, not a longer timeout. And cPanel mail servers often present a
# certificate for the server's own hostname rather than for mail.lcci.com.pk,
# which fails verification; point SMTP_HOST at the name on the certificate before
# reaching for the flag below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Set to 0 to accept any TLS certificate. It is a flag rather than a default so
# that turning it off is a recorded decision: it makes the session encrypted
# against someone listening and worthless against someone interposing, on mail
# that carries sign-in codes.
SMTP_TLS_REJECT_UNAUTHORIZED=1

# Set to 1 to hold a connection open between messages. Off by default: a pooled
# socket inside a Passenger worker that may be killed between requests is not
# worth the handshake it saves.
SMTP_POOL=

# Where the website's contact form sends enquiries. Falls back to the
# correspondence address the chamber already publishes on the contact page.
# Here rather than in the code because which inbox owns this is an operational
# decision, and LCCI should be able to change it without a deploy.
CONTACT_INBOX=

# Optional. With no token set, mail is logged instead of sent, which is the
# normal state of a development machine. In production the absence is logged
# loudly at startup, because silently not sending mail is the failure that takes
# longest to notice: every flow appears to succeed.
POSTMARK_TOKEN=
POSTMARK_STREAM_TRANSACTIONAL=outbound
POSTMARK_STREAM_BROADCAST=broadcast

# The From address. It must be on the same domain as SITE_ORIGIN.
#
# This is not a preference. Sign-in codes arriving from a domain other than the
# one in the member's address bar teach members that LCCI login mail comes from
# varied domains, which is the precondition phishing needs. Staff use
# @lcci.org.pk while the site is lcci.com.pk — resolve that (plan open question
# 15) before the login flow ships.
#
# SPF, DKIM and DMARC must be published for this domain before the first send.
MAIL_FROM=


# --- Content Security Policy --------------------------------------------------

# Unset or `false`: the policy is sent as Content-Security-Policy-Report-Only
# and violations are collected at /api/csp-report. `true`: it is enforced.
#
# Ship Report-Only first and read the reports for a fortnight. An enforcing CSP
# shipped blind to a site with third-party embeds and a CMS breaks something on
# day one, and the breakage is invisible to whoever shipped it — a blocked
# script simply does not run.
CSP_ENFORCE=false
