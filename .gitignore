node_modules/
.next/
out/
build/
# Every environment file, then the template back. `.env.*` rather than a list
# of the names in use, because the one that gets committed is always the one
# nobody thought to add — `.env.production` matched neither `.env` nor
# `.env*.local`. Keep the negation: without it this swallows the example and
# the only record of what the host has to set goes with it.
.env
.env.*
!.env.example
*.tsbuildinfo
next-env.d.ts
.DS_Store
tmp/

# `npm run preview` output — rendered page snapshots, for looking at.
preview/

# A backup archive of the source tree, not a deliverable.
src.zip

# Scraped pages and assets from lcci.com.pk, kept locally while the import
# runs. The migrations have consumed it; what matters is in the database and
# in public/, and 4.5 MB of someone else's rendered HTML is not history worth
# carrying.
legacy-import/
